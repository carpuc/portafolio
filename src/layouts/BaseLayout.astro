---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Caja de herramientas de Carlos Puc, Desarrollador Web Full Stack, con utilidades para trabajar a diario." />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="keywords" content="desarrollador web, frontend, backend, full stack, caja de herramientas, herramientas de desarrollo, .NET, Sql Server, Progress OpenEdge" />
    <meta name="author" content="Carlos Puc" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content="Caja de herramientas de Carlos Puc - Desarrollador Web Full Stack" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content="Caja de herramientas de Carlos Puc - Desarrollador Web Full Stack" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
<style is:global>
  :root {
    --bg: #0a0a0a;
    --text: #ededed;
    --text-muted: #888888;
    --accent: #3b82f6;
    --card-bg: #1a1a1a;
    --border: #2a2a2a;
  }

  [data-theme="light"] {
    --bg: #ffffff;
    --text: #1a1a1a;
    --text-muted: #666666;
    --accent: #2563eb;
    --card-bg: #f5f5f5;
    --border: #e5e5e5;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, sans-serif;
    background-color: var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  a {
    color: var(--accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
  }

  section {
    padding: 4rem 0;
  }

  h1, h2, h3 {
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.5rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  .btn {
    background-color: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 1.25rem;
    cursor: pointer;
    font-size: 0.9rem;
    transition: background-color 0.2s, color 0.2s, border-color 0.2s;
  }

  .btn:hover {
    border-color: var(--accent);
  }

  .btn-primary {
    background-color: var(--accent);
    border-color: var(--accent);
    color: #fff;
  }

  .btn-primary:hover {
    filter: brightness(1.1);
  }

  .tool-error {
    display: none;
    color: #ef4444;
    background-color: rgba(239, 68, 68, 0.1);
    border: 1px solid rgba(239, 68, 68, 0.4);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-size: 0.875rem;
  }

  .tool-error.visible {
    display: block;
  }
</style>
