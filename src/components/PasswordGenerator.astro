<div class="pw-formatter">
  <div class="pw-controls">
    <div class="pw-field">
      <label class="pw-label" for="pw-length">Longitud</label>
      <div class="pw-length-row">
        <input
          id="pw-length"
          class="pw-slider"
          type="range"
          min="4"
          max="64"
          step="1"
          value="16"
          aria-label="Longitud de la contraseña"
        />
        <output id="pw-length-value" class="pw-length-value" for="pw-length">16</output>
      </div>
      <div class="pw-shortcuts">
        <button class="pw-shortcut" type="button" data-length="8">8</button>
        <button class="pw-shortcut" type="button" data-length="12">12</button>
        <button class="pw-shortcut" type="button" data-length="16">16</button>
        <button class="pw-shortcut" type="button" data-length="20">20</button>
      </div>
    </div>

    <div class="pw-field">
      <span class="pw-label">Incluir</span>
      <div class="pw-pools">
        <label class="pw-check">
          <input type="checkbox" id="pw-upper" checked />
          Mayúsculas (A–Z)
        </label>
        <label class="pw-check">
          <input type="checkbox" id="pw-lower" checked />
          Minúsculas (a–z)
        </label>
        <label class="pw-check">
          <input type="checkbox" id="pw-digits" checked />
          Números (0–9)
        </label>
        <label class="pw-check">
          <input type="checkbox" id="pw-symbols" checked />
          Símbolos
        </label>
        <label class="pw-check pw-check-fine">
          <input type="checkbox" id="pw-fine" />
          Símbolos finos (; : , . ?)
        </label>
      </div>
    </div>

    <div class="pw-field">
      <label class="pw-label" for="pw-exclude">Excluir caracteres</label>
      <input id="pw-exclude" class="pw-exclude" type="text" placeholder="Ej. Il1oO0" spellcheck="false" />
    </div>
  </div>

  <p id="pw-error" class="tool-error" role="alert"></p>

  <div class="pw-output-wrap">
    <label class="pw-label" for="pw-output">Contraseña</label>
    <input id="pw-output" class="pw-output" type="text" readonly aria-live="polite" spellcheck="false" />
    <span id="pw-strength" class="pw-strength"></span>
  </div>

  <div class="pw-actions">
    <button id="pw-generate" class="btn btn-primary" type="button">Actualizar</button>
    <button id="pw-copy" class="btn" type="button">Copiar</button>
    <button id="pw-save" class="btn" type="button">Guardar</button>
  </div>
</div>

<script>
  import { copyText } from '../lib/clipboard';
  import { downloadBlob } from '../lib/download';

  const UPPER = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
  const LOWER = 'abcdefghijklmnopqrstuvwxyz';
  const DIGITS = '0123456789';
  const SYMBOLS = '!@#$%^&*()-_=+[]{}';
  const FINE_SYMBOLS = ';:,.?';

  const lengthInput = document.getElementById('pw-length');
  const lengthValue = document.getElementById('pw-length-value');
  const upperCheck = document.getElementById('pw-upper');
  const lowerCheck = document.getElementById('pw-lower');
  const digitsCheck = document.getElementById('pw-digits');
  const symbolsCheck = document.getElementById('pw-symbols');
  const fineCheck = document.getElementById('pw-fine');
  const excludeInput = document.getElementById('pw-exclude');
  const output = document.getElementById('pw-output');
  const generateBtn = document.getElementById('pw-generate');
  const copyBtn = document.getElementById('pw-copy');
  const saveBtn = document.getElementById('pw-save');
  const strengthEl = document.getElementById('pw-strength');
  const errorEl = document.getElementById('pw-error');
  const shortcuts = document.querySelectorAll('.pw-shortcut');

  function showError(msg) {
    errorEl.textContent = msg;
    errorEl.classList.add('visible');
  }

  function clearError() {
    errorEl.textContent = '';
    errorEl.classList.remove('visible');
  }

  function randomIndex(poolSize) {
    const limit = Math.floor(256 / poolSize) * poolSize;
    const buf = new Uint8Array(1);
    let v;
    do {
      crypto.getRandomValues(buf);
      v = buf[0];
    } while (v >= limit);
    return v % poolSize;
  }

  function symbolsPool() {
    return SYMBOLS + (fineCheck.checked ? FINE_SYMBOLS : '');
  }

  function activePools() {
    const pools = [];
    if (upperCheck.checked) pools.push(UPPER);
    if (lowerCheck.checked) pools.push(LOWER);
    if (digitsCheck.checked) pools.push(DIGITS);
    if (symbolsCheck.checked) pools.push(symbolsPool());
    return pools;
  }

  function setStrength(poolsCount, length) {
    if (!poolsCount || !length) {
      strengthEl.textContent = '';
      strengthEl.className = 'pw-strength';
      return;
    }
    let level = 'weak';
    let label = 'Débil';
    if (poolsCount >= 4 && length >= 20) {
      level = 'strong';
      label = 'Fuerte';
    } else if (poolsCount >= 2 && length >= 8) {
      level = 'medium';
      label = 'Media';
    }
    strengthEl.textContent = 'Fortaleza: ' + label;
    strengthEl.className = 'pw-strength strength-' + level;
  }

  function generate() {
    clearError();
    const length = lengthInput.valueAsNumber;
    const excluded = excludeInput.value.split('');
    const filtered = activePools().map((pool) =>
      [...pool].filter((c) => !excluded.includes(c)).join('')
    );

    if (filtered.length === 0) {
      showError('Selecciona al menos un tipo de caracteres.');
      output.value = '';
      setStrength(0, 0);
      return;
    }
    const empty = filtered.find((pool) => pool.length === 0);
    if (empty !== undefined) {
      showError('La exclusión dejó vacío un pool de caracteres. Quita algunos caracteres excluidos.');
      output.value = '';
      setStrength(0, 0);
      return;
    }

    const union = filtered.join('');
    const chars = [];
    for (const pool of filtered) {
      chars.push(pool[randomIndex(pool.length)]);
    }
    while (chars.length < length) {
      chars.push(union[randomIndex(union.length)]);
    }
    for (let i = chars.length - 1; i > 0; i--) {
      const j = randomIndex(i + 1);
      [chars[i], chars[j]] = [chars[j], chars[i]];
    }

    output.value = chars.join('');
    setStrength(filtered.length, length);
  }

  lengthInput?.addEventListener('input', () => {
    lengthValue.textContent = lengthInput.value;
    generate();
  });

  for (const btn of shortcuts) {
    btn?.addEventListener('click', () => {
      lengthInput.value = btn.dataset.length;
      lengthValue.textContent = btn.dataset.length;
      generate();
    });
  }

  for (const check of [upperCheck, lowerCheck, digitsCheck, symbolsCheck, fineCheck]) {
    check?.addEventListener('change', generate);
  }

  excludeInput?.addEventListener('input', generate);

  generateBtn?.addEventListener('click', generate);

  copyBtn?.addEventListener('click', async () => {
    clearError();
    if (!output.value) {
      showError('No hay contraseña para copiar. Genera una primero.');
      return;
    }
    const label = copyBtn.textContent;
    try {
      await copyText(output.value);
      copyBtn.textContent = '✓ Copiado';
    } catch {
      copyBtn.textContent = '✓ Copiado';
    }
    setTimeout(() => {
      copyBtn.textContent = label;
    }, 1500);
  });

  saveBtn?.addEventListener('click', () => {
    clearError();
    if (!output.value) {
      showError('No hay contraseña para guardar. Genera una primero.');
      return;
    }
    const blob = new Blob([output.value], { type: 'text/plain' });
    downloadBlob(blob, 'password.txt');
  });

  generate();
</script>

<style>
  .pw-formatter {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pw-controls {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .pw-field {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pw-label {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .pw-length-row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pw-slider {
    flex: 1;
    accent-color: var(--accent);
    cursor: pointer;
  }

  .pw-length-value {
    min-width: 2rem;
    text-align: center;
    font-weight: 600;
    font-size: 1rem;
  }

  .pw-shortcuts {
    display: flex;
    gap: 0.5rem;
  }

  .pw-shortcut {
    background-color: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.75rem;
    cursor: pointer;
    font-size: 0.875rem;
    transition: border-color 0.2s;
  }

  .pw-shortcut:hover {
    border-color: var(--accent);
  }

  .pw-pools {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .pw-check {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.875rem;
    color: var(--text);
    cursor: pointer;
  }

  .pw-check input {
    accent-color: var(--accent);
    width: 1rem;
    height: 1rem;
    cursor: pointer;
  }

  .pw-check-fine {
    color: var(--text-muted);
  }

  .pw-exclude {
    max-width: 16rem;
    background-color: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }

  .pw-exclude:focus {
    outline: none;
    border-color: var(--accent);
  }

  .pw-output-wrap {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pw-output {
    width: 100%;
    background-color: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.75rem 1rem;
    font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
    font-size: 1.125rem;
    letter-spacing: 0.05em;
  }

  .pw-output:focus {
    outline: none;
    border-color: var(--accent);
  }

  .pw-strength {
    font-size: 0.875rem;
    color: var(--text-muted);
  }

  .pw-strength.strength-weak {
    color: #f59e0b;
  }

  .pw-strength.strength-medium {
    color: #3b82f6;
  }

  .pw-strength.strength-strong {
    color: #10b981;
  }

  .pw-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
</style>